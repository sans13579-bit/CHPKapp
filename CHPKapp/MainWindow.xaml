<Window x:Class="CHPKapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Общежитие ЧПК" Height="700" Width="1100"
        Icon="/Images/CHPKlogo.png"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource PrimaryHueMidBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="15,20,15,30">
                    <materialDesign:PackIcon Kind="School" Width="30" Height="30" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="ЧПК" Foreground="White" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BtnJournal" Content="Журнал ключей" Click="BtnJournal_Click" 
        Style="{StaticResource MaterialDesignFlatButton}" 
        Foreground="White" 
        HorizontalContentAlignment="Left" 
        VerticalContentAlignment="Center"
        Padding="15,10" 
        Height="40"
        Margin="5,0" Cursor="Hand"/>

                <Button x:Name="BtnUsers" Content="Пользователи" Click="BtnUsers_Click" 
        Style="{StaticResource MaterialDesignFlatButton}" 
        Foreground="White" 
        HorizontalContentAlignment="Left" 
        VerticalContentAlignment="Center"
        Padding="15,10" 
        Height="40"
        Margin="5,0"/>

                <Button x:Name="BtnSettings" Content="Настройки" Click="BtnSettings_Click" 
        Style="{StaticResource MaterialDesignFlatButton}" 
        Foreground="White" 
        HorizontalContentAlignment="Left" 
        VerticalContentAlignment="Center"
        Padding="15,10" 
        Height="40"
        Margin="5,0"/>

                <Separator Margin="15,20" Background="#44FFFFFF"/>

                <Button Content="Выйти" Click="BtnLogout_Click" 
        Style="{StaticResource MaterialDesignFlatButton}" 
        Foreground="White" 
        HorizontalContentAlignment="Left" 
        VerticalContentAlignment="Center"
        Padding="15,10" 
        Height="40"
        Margin="5,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" Grid.Row="0" Text="Журнал учёта ключей" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="BtnAddRecord" Content="Выдать ключ" Click="BtnAddRecord_Click" 
                Style="{StaticResource MaterialDesignRaisedButton}" 
                Height="40" Margin="0,0,10,0"/>

                <Button x:Name="BtnReturnKey" Content="Сдать ключ" Click="BtnReturnKey_Click" 
                Style="{StaticResource MaterialDesignOutlinedButton}" 
                Height="40"/>
            </StackPanel>

            <DataGrid x:Name="MainDataGrid" Grid.Row="2" AutoGenerateColumns="False" 
          CanUserAddRows="False" IsReadOnly="True"
          materialDesign:DataGridAssist.CellPadding="10 5" 
          materialDesign:DataGridAssist.ColumnHeaderPadding="10 5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding RecordDate, StringFormat=dd.MM.yyyy}" Width="80"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTextColumn Header="Комната" Binding="{Binding RoomNumber}" Width="80"/>
                    <DataGridTextColumn Header="Время выдачи" Binding="{Binding IssueTime}" Width="100"/>
                    <DataGridTextColumn Header="Время возврата" Binding="{Binding ReturnTime}" Width="120"/>
                    <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>