<Window x:Class="CHPKapp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Вход - Общежитие ЧПК" Height="450" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Images/CHPKlogo.png">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">

            <Image Height="114" Width="126" Source="/Images/CHPKlogo.png"/>
            <TextBlock Text="Общежитие ЧПК" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBox x:Name="LoginTextBox" materialDesign:HintAssist.Hint="Логин" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>
            <PasswordBox x:Name="PasswordBox" materialDesign:HintAssist.Hint="Пароль" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,25"/>

            <Button Content="Войти" Click="BtnLogin_Click" Style="{StaticResource MaterialDesignRaisedButton}" Height="40" FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>